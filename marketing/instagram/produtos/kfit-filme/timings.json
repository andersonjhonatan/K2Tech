{
 "voff": 0.4,
 "tail": 3.8,
 "lines": [
  {
   "id": "l1",
   "text": "Cinco e meia da manhã. O Rafael já está na academia.",
   "gap": 0.6,
   "start": 0.052,
   "end": 3.314
  },
  {
   "id": "l2",
   "text": "Personal trainer. Doze alunos por dia, e um celular que não para.",
   "gap": 0.6,
   "start": 3.672,
   "end": 8.131
  },
  {
   "id": "l3",
   "text": "A ficha de treino é no papel. E o aluno perde.",
   "gap": 0.4,
   "start": 8.457,
   "end": 11.268
  },
  {
   "id": "l4",
   "text": "A carga fica na cabeça. Ninguém lembra quanto pegou.",
   "gap": 0.4,
   "start": 11.4,
   "end": 14.16
  },
  {
   "id": "l5",
   "text": "E no fim do mês, cobrar a mensalidade fica sempre pra depois.",
   "gap": 0.7,
   "start": 14.457,
   "end": 18.027
  },
  {
   "id": "l6",
   "text": "Ele não tem tempo de cuidar do negócio. Está ocupado demais cuidando de pessoas.",
   "gap": 1.0,
   "start": 18.288,
   "end": 22.653
  },
  {
   "id": "l7",
   "text": "Pensando em profissionais como ele, a TresK Tecnologia criou o KFit.",
   "gap": 0.5,
   "start": 23.07,
   "end": 27.348
  },
  {
   "id": "l8",
   "text": "O app que organiza o trabalho do personal, do treino à mensalidade.",
   "gap": 0.6,
   "start": 27.539,
   "end": 31.366
  },
  {
   "id": "l9",
   "text": "O aluno recebe o treino no celular, com vídeo e meta de carga.",
   "gap": 0.4,
   "start": 31.567,
   "end": 35.005
  },
  {
   "id": "l10",
   "text": "Marca cada série. E o personal vê na hora quem evoluiu.",
   "gap": 0.4,
   "start": 35.192,
   "end": 38.55
  },
  {
   "id": "l11",
   "text": "Avaliação física, evolução em gráfico e cobrança por Pix.",
   "gap": 0.4,
   "start": 38.743,
   "end": 42.259
  },
  {
   "id": "l12",
   "text": "Tudo com a marca do seu studio.",
   "gap": 0.7,
   "start": 42.438,
   "end": 44.174
  },
  {
   "id": "l13",
   "text": "Menos papel. Mais tempo pra cuidar de gente.",
   "gap": 0.5,
   "start": 44.361,
   "end": 47.075
  },
  {
   "id": "l14",
   "text": "Para personal trainers, studios de funcional e pequenas academias.",
   "gap": 0.9,
   "start": 47.229,
   "end": 50.922
  },
  {
   "id": "l15",
   "text": "KFit. Em breve.",
   "gap": 0.6,
   "start": 51.286,
   "end": 52.268
  },
  {
   "id": "l16",
   "text": "Desenvolvido pela TresK Tecnologia. Chama no direct e seja um dos primeiros.",
   "gap": 0,
   "start": 52.593,
   "end": 58.155
  }
 ],
